{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/companion-plan.js": {
      "includeFiles": "data/{trip-*.js,companion-maps.json}"
    },
    "api/create-plan-draft.js": {
      "maxDuration": 300
    },
    "api/update-booking-status.js": {
      "maxDuration": 120,
      "includeFiles": "{assets/*-routes.geojson,data/companion-maps.json}"
    },
    "api/update-accommodation-options.js": {
      "maxDuration": 120,
      "includeFiles": "{assets/*-routes.geojson,data/companion-maps.json}"
    },
    "api/publish-roadbook.js": {
      "maxDuration": 120,
      "includeFiles": "{assets/*-routes.geojson,data/companion-maps.json}"
    },
    "api/publish-accommodations.js": {
      "maxDuration": 120,
      "includeFiles": "{assets/*-routes.geojson,data/companion-maps.json}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/reise-roadbook-2026.html"
    },
    {
      "source": "/unterkuenfte",
      "destination": "/unterkuenfte-2026.html"
    },
    {
      "source": "/unterkuenfte.html",
      "destination": "/unterkuenfte-2026.html"
    }
  ],
  "headers": [
    {
      "source": "/reise-roadbook-2026.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/unterkuenfte-2026.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/trip-spanien-2026.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/trip-adria-2026.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/animations/catalog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/animations/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
