      <Placemark><name>Tag 1 Grenoble</name><description>Standard-Anreiseziel ueber Autobahnkorridor; Annecy/Chambery nur Ausweichuebernachtung; Crit'Air/ZFE und Garage pruefen</description><styleUrl>#overnight</styleUrl><Point><coordinates>5.7245,45.1885,0</coordinates></Point></Placemark>
      <Placemark><name>Tag 2 Sisteron</name><description>Route Napoleon N85; Gorges de la Meouge nur separate trockene Zusatzrunde</description><styleUrl>#overnight</styleUrl><Point><coordinates>5.9462,44.1984,0</coordinates></Point></Placemark>
      <Placemark><name>Tag 3 Lourmarin</name><description>Luberon-Basis</description><styleUrl>#overnight</styleUrl><Point><coordinates>5.3639,43.7638,0</coordinates></Point></Placemark>
