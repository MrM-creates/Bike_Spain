<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Spanienroute mit Camargue - Strassenpunkte fuer Planung</name>
    <description><![CDATA[
Planungs-KML fuer Google My Maps / Google Earth.

Start ist Berikon AG. Die KML enthaelt Strassenpunkte und grobe Linien, damit Google Maps/My Maps die gewuenschten Korridore sichtbar macht:
N85 Route Napoleon, Luberon, Camargue D570/D38/D58/D979, Priorat, N-420/A-1512 nach Albarracin, Valencia-Altea durchs Hinterland, Alpujarras A-348/A-4132, Grazalema A-372/CA-9104 und Rueckweg via Ubeda, Cuenca, Zaragoza.

Das ist keine fertige Abbiege-Navigation. Jede Tagesetappe vor der Fahrt pruefen.
]]></description>

    <Style id="mainLine"><LineStyle><color>ff1f6feb</color><width>4</width></LineStyle></Style>
    <Style id="camargueLine"><LineStyle><color>ff1aa184</color><width>4</width></LineStyle></Style>
    <Style id="localLine"><LineStyle><color>ffec8b23</color><width>4</width></LineStyle></Style>
    <Style id="ferryLine"><LineStyle><color>ff8a63d2</color><width>4</width></LineStyle></Style>
    <Style id="stopMarker">
      <IconStyle><scale>0.9</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon></IconStyle>
      <LabelStyle><scale>0.72</scale></LabelStyle>
    </Style>

    <Folder>
      <name>Hauptstopps</name>
      <Placemark><name>01 Berikon</name><description>Start. Korrigiert: Berikon, nicht Bellikon.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>8.3722,47.3507,0</coordinates></Point></Placemark>
      <Placemark><name>02 Grenoble</name><description>Anreise bis hier effizient ueber Autobahn/grosse Strassen.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>5.7245,45.1885,0</coordinates></Point></Placemark>
      <Placemark><name>03 Sisteron</name><description>N85 Route Napoleon.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>5.9462,44.1984,0</coordinates></Point></Placemark>
      <Placemark><name>04 Aix / Luberon</name><description>Provence-/Luberon-Basis.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>5.4474,43.5297,0</coordinates></Point></Placemark>
      <Placemark><name>05 Arles</name><description>Camargue-Basis.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>4.6278,43.6766,0</coordinates></Point></Placemark>
      <Placemark><name>06 Saintes-Maries-de-la-Mer</name><description>D570; keine Pisten/Schutzgebietswege.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>4.4290,43.4523,0</coordinates></Point></Placemark>
      <Placemark><name>07 Aigues-Mortes</name><description>D38/D58; danach D979 Richtung Nimes.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>4.1906,43.5669,0</coordinates></Point></Placemark>
      <Placemark><name>08 Nimes</name><description>Verbindliche Basis nach der Camargue.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>4.3601,43.8367,0</coordinates></Point></Placemark>
      <Placemark><name>09 Carcassonne</name><description>Zwischenstopp Richtung Barcelona.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>2.3510,43.2130,0</coordinates></Point></Placemark>
      <Placemark><name>10 Barcelona</name><description>Stadtstopp; Garage.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>2.1686,41.3874,0</coordinates></Point></Placemark>
      <Placemark><name>11 Falset / Priorat</name><description>Priorat-Basis.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>0.8200,41.1460,0</coordinates></Point></Placemark>
      <Placemark><name>12 Albarracin</name><description>A-1512 via Gea de Albarracin; nicht in Altstadt routen.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-1.4440,40.4070,0</coordinates></Point></Placemark>
      <Placemark><name>13 Valencia</name><description>Stadtstopp; Garage.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-0.3763,39.4699,0</coordinates></Point></Placemark>
      <Placemark><name>14 Altea</name><description>Costa-Blanca-Basis.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-0.0450,38.6029,0</coordinates></Point></Placemark>
      <Placemark><name>15 Granada</name><description>Stadtstopp; kurze Alpujarras-Runde moeglich.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-3.5990,37.1770,0</coordinates></Point></Placemark>
      <Placemark><name>16 Ronda</name><description>Basis fuer Grazalema-Runde.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-5.1610,36.7460,0</coordinates></Point></Placemark>
      <Placemark><name>17 Ubeda / Baeza</name><description>Rueckweg durch Jaen.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-3.3710,38.0110,0</coordinates></Point></Placemark>
      <Placemark><name>18 Cuenca</name><description>Kompakter Zwischenstopp.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-2.1370,40.0700,0</coordinates></Point></Placemark>
      <Placemark><name>19 Zaragoza</name><description>Rueckweg nach Barcelona.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>-0.8891,41.6488,0</coordinates></Point></Placemark>
      <Placemark><name>20 Barcelona vor Faehre</name><description>Rueckkehr nach Barcelona.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>2.1686,41.3874,0</coordinates></Point></Placemark>
      <Placemark><name>21 Genoa</name><description>Faehre Barcelona-Genua; symbolische Linie.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>8.9463,44.4056,0</coordinates></Point></Placemark>
      <Placemark><name>22 Berikon</name><description>Ziel.</description><styleUrl>#stopMarker</styleUrl><Point><coordinates>8.3722,47.3507,0</coordinates></Point></Placemark>
    </Folder>

